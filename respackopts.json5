{
    id: "CreaturesPlus",
    version: 13,
    capabilities: ["FileFilter", "DirFilter", "DirFilterAdditive"],
    conf: {
            gayBees: ["default", "gay", "gayless"],
            naturallySpawningCreakingBiomeVariants: ["off", "on"],
            creeperSpawningConditions: ["default", "noVanilla", "onlyVanilla", "dungeonsVanilla", "onlyDungeons"],
            villagers: {
                villagerFacialHairPercentage: {
                    type: "integer",
                    default: 40,
                    min: 0,
                    max: 100
                },
                villagerFacialScars: ["on","off"],
                villagerFacialWear: ["on","off"],
                villagerRaces: ["on","off"]
            }
    }
}