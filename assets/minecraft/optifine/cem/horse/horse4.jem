					"var.Lleg_ty_run": "clamp(((-cos(time/1.5)*4)-11), -99, -11)",
					"var.Lleg_ty_jog": "clamp(((-cos(time/2)*4)-11), -99, -11)",
					"var.Lleg_ty_walk": "clamp(((-cos(time/3)*4)-11), -99, -11)",
					"Lleg.rx": "if(limb_speed>0.1 && limb_speed<0.35, var.Lleg_rx_walk, if(limb_speed>0.35 && limb_speed<0.75, var.Lleg_rx_jog, if(limb_speed>0.75, var.Lleg_rx_run, 0)))",
