					"Lleg.tz": "if(limb_speed>0.1 && limb_speed<0.35, var.Lleg_tz_walk, if(limb_speed>0.35 && limb_speed<0.75, var.Lleg_tz_jog, if(limb_speed>0.75, var.Lleg_tz_run, 2)))",
